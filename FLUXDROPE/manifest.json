  "shortcuts": [
    {
      "name": "Send Files",
      "short_name": "Send",
      "description": "Create a new peer-to-peer file transfer session",
      "url": "/#send",
      "icons": [
        {
          "src": "assets/icons/icon-192x192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Receive Files",
      "short_name": "Receive",
      "description": "Join an existing transfer session with a 6-digit code or link",
